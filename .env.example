# Copy to .env; npm start loads it when present. Never commit real keys.
TFL_APP_KEY=
HOST=127.0.0.1
PORT=3000
# Demonstration data is opt-in, never a fallback for a failed live feed.
DEMO_MODE=false

# National Rail public Live Departure Board subscription (Rail Data Marketplace).
# Key is secret. Copy the product base URL from your subscription's Specification;
# it ends with /LDBWS/api/20220120, without a station/operation or query string.
NATIONAL_RAIL_API_KEY=
NATIONAL_RAIL_API_BASE=
